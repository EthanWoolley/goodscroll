# Expo environment. Copy to `app/.env`: cp app/.env.example app/.env
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle, and they
# are embedded in it at build time — never put a secret here.

# Base URL of the backend API. Defaults to http://127.0.0.1:8000 when unset, which works
# for web and simulators; on a physical device set it to your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
