# Backend environment. Copy to `.env` at the repo root: cp .env.example .env
# Loaded by python-dotenv from backend/main.py, alembic/env.py and scripts/seed_from_sqlite.py.

# Anthropic API key, used for card generation, completeness evaluation and Wikipedia keyword extraction.
# Read by the `anthropic` SDK whenever a request arrives without an `X-Anthropic-Key` header.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Async PostgreSQL connection string used by the API, migrations and the seed script.
# Must use the `postgresql+asyncpg://` scheme; alembic rewrites it to psycopg2 itself.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/scrollapp
